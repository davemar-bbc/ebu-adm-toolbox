{
    "$schema": "../data/schemas/config.schema.json",
    "version": 0,
    "processes": [
        {
            "name": "input",
            "type": "read_adm_bw64",
            "out_ports": ["out_axml"]
        },
        {
            "name": "add_block_rtimes",
            "type": "add_block_rtimes",
            "in_ports": ["in_axml"],
            "out_ports": ["out_axml"]
        },
        {
            "name": "hoa_encoder",
            "type": "hoa_encoder",
            "in_ports": ["in_axml"],
            "out_ports": ["out_samples", "out_axml"]
        },
        {
            "name": "output",
            "type": "write_adm_bw64",
            "in_ports": ["in_samples", "in_axml"]
        }
    ],
    "connections": [
        ["input.out_samples", "hoa_encoder.in_samples"]
    ]
}
